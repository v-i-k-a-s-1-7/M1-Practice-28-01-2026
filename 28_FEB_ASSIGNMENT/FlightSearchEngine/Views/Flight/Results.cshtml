@model IEnumerable<FlightSearchEngine.Models.FlightResult>

<h2>Flight Search Results</h2>

@if (Model == null || !Model.Any())
{
    <p>No results found.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Flight Id</th>
                <th>Flight Name</th>
                <th>Flight Type</th>
                <th>Source</th>
                <th>Destination</th>
                <th>Total Cost</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FlightId</td>
                    <td>@item.FlightName</td>
                    <td>@item.FlightType</td>
                    <td>@item.Source</td>
                    <td>@item.Destination</td>
                    <td>@item.TotalCost</td>
                </tr>
            }
        </tbody>
    </table>
}

<a href="/Flight/Index" class="btn btn-primary">Back to Search</a>